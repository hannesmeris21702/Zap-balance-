# Sui Network Configuration
# Use mainnet, testnet, or devnet RPC URL
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Your Wallet Private Key (hex format, WITHOUT 0x prefix)
# IMPORTANT: Keep this secret! Never commit to version control
# Example format: 4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b
WALLET_PRIVATE_KEY=your_private_key_here

# Bot Configuration
# How often to check positions and rebalance (in milliseconds)
# Minimum: 1000 (1 second), Recommended: 60000 (1 minute) or higher
# Lower values = more frequent checks but higher RPC usage and gas costs
REBALANCE_INTERVAL_MS=60000

# RPC indexing delay in milliseconds after creating a new position (default: 5000 = 5 seconds)
# Recommended by Cetus SDK to allow RPC nodes to index new positions before querying
# Minimum: 1000ms (1 second) - lower values may cause position detection failures
# Increase if experiencing position detection issues due to network latency or RPC lag
RPC_INDEXING_DELAY_MS=5000

# Gas Budget Configuration
# Maximum gas budget for transactions (in MIST, where 1 SUI = 1,000,000,000 MIST)
# Default: 500000000 (0.5 SUI)
# Adjust based on transaction complexity and network conditions
# - Simple operations: 100000000 (0.1 SUI)
# - Standard operations: 500000000 (0.5 SUI) - recommended
# - Complex operations: 1000000000 (1.0 SUI)
GAS_BUDGET_MIST=500000000

# MAINNET SAFE TEST MODE
# Set to 'true' for single-shot testing on mainnet
# When enabled:
# - Processes ONLY the FIRST position found
# - Executes ONLY ONE rebalance cycle
# - Exits immediately after completion
# - Aborts on any error
# Set to 'false' or omit for continuous monitoring mode
MAINNET_TEST_MODE=false

# Cetus SDK Configuration
# CLMM Package ID - the main Cetus CLMM smart contract package
CETUS_CLMM_PACKAGE_ID=0x1eabed72c53feb3805120a081dc15963c204dc8d091542592abaf7a35689b2fb
# Global Config ID - the Cetus CLMM global configuration object
CETUS_GLOBAL_CONFIG_ID=0xdaa46292632c3c4d8f31f23ea0f9b36a28ff3677e9684980e4438403a67a3d8f
